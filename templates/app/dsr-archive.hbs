<div class="dsr-archive-container">
  {{#each archiveEntries as |e|}}
  <div class="dsr-archive-card">
    <div class="dsr-card-header">
      <div class="header-meta">
        <i class="fas fa-database"></i>
        <span class="mission-title">{{e.title}}</span>
      </div>
      <div class="dsr-archive-action-container">
        <button type="button" class="dsr-restore-btn" data-page-id="{{e.id}}" title="{{localize "dsrTerminal.ArchiveTab.Btn.Titles.Restore"}}"
          data-action="restore">
          <i class="fas fa-file-import"></i> {{localize "dsrTerminal.ArchiveTab.Btn.Restore"}}
        </button>
        <button type="button" class="dsr-restore-btn" data-page-id="{{e.id}}" title="{{localize "dsrTerminal.ArchiveTab.Btn.Titles.Send"}}"
          data-action="sendFromArchive">
          <i class="fas fa-send"></i> {{localize "dsrTerminal.ArchiveTab.Btn.Send"}}
        </button>
      </div>
    </div>
    <div class="dsr-archive-step dsr-archive-description">
      <div class="step-label">{{localize "dsrTerminal.ArchiveTab.Entry.Description"}}</div>
      <div class="dsr-decription-content">{{e.description}}</div>
    </div>
    <div class="dsr-steps-grid">
      {{#each e.steps as |s|}}
      <div class="dsr-archive-step {{#if s.bypassed}}is-bypassed{{/if}}">
        <div class="step-label">{{localize "dsrTerminal.FormTab.Step.Label"}} {{s.label}}</div>
        <div class="step-summary">{{s.summary}}</div>
        {{#if s.details}}<div class="step-details">{{s.details}}</div>{{/if}}
      </div>
      {{/each}}
    </div>

    {{#if e.lde}}
    <div class="dsr-archive-lde">
      <div class="lde-tag">[ {{localize "dsrTerminal.LDE"}} ]</div>
      <div class="lde-content">
        <div class="lde-description">{{e.lde.description}}</div>
        <div class="lde-summary">{{e.lde.summary}}</div>
        <div class="lde-details">{{e.lde.details}}</div>
      </div>
    </div>
    {{/if}}
  </div>
  {{/each}}
</div>